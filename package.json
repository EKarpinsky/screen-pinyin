{
  "name": "screen-pinyin",
  "productName": "ScreenPinyin Translator",
  "version": "1.0.0",
  "description": "Capture Chinese text from screen, get Pinyin and English translation",
  "main": ".webpack/main",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "build:dictionary": "node scripts/build-sqlite-dictionary.mjs"
  },
  "keywords": [
    "electron",
    "ocr",
    "chinese",
    "pinyin",
    "translation"
  ],
  "author": {
    "name": "ScreenPinyin"
  },
  "license": "MIT",
  "dependencies": {
    "@azure-rest/ai-translation-text": "^1.0.1",
    "@floating-ui/react": "^0.27.16",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "axios": "^1.13.2",
    "better-sqlite3": "^12.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^10.0.0",
    "lucide-react": "^0.454.0",
    "node-schedule": "^2.1.1",
    "nodejieba": "^3.5.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hotkeys-hook": "^5.2.1",
    "robotjs": "^0.6.0",
    "screenshot-desktop": "^1.15.0",
    "sharp": "^0.33.5",
    "tailwind-merge": "^3.3.1",
    "tesseract.js": "^5.1.1",
    "ts-fsrs": "^5.2.3",
    "use-debounce": "^10.0.6"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.2",
    "@electron-forge/plugin-fuses": "^7.10.2",
    "@electron-forge/plugin-webpack": "^7.10.2",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^4.0.1",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.1.9",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/node-schedule": "^2.1.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vercel/webpack-asset-relocator-loader": "^1.7.3",
    "@vitejs/plugin-react": "^5.1.1",
    "css-loader": "^7.1.2",
    "dependency-cruiser": "^17.3.2",
    "electron": "39.2.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fork-ts-checker-webpack-plugin": "^9.0.2",
    "globals": "^16.5.0",
    "jsdom": "^27.2.0",
    "node-loader": "^2.1.0",
    "postcss": "^8.5.0",
    "postcss-loader": "^8.1.1",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.1.9",
    "ts-loader": "^9.5.1",
    "tw-animate-css": "^1.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.14"
  }
}
